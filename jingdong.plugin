#!name = 京东（比价·自托管版）
#!desc = 1.过滤京东广告；2.历史比价信息，任选其一即可。（首次使用请先打开【慢慢买App-我的】，提示【获取ck成功🎉】即可正常比价。）\n此插件仅支持京东标准模式。\n【本版改动】全部脚本改为本仓库自托管，不依赖 GitHub raw / 作者 CDN。
#!openUrl = https://apps.apple.com/app/id414245413
#!author = RuCu6[https://github.com/RuCu6], Maasea[https://github.com/Maasea], MuTu[https://github.com/githubdulong], 苍井灰灰[https://github.com/wf021325], mw418[https://github.com/mw418], 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!tag = 去广告, 功能增强
#!system =
#!system_version =
#!loon_version = 3.5.2(1005)
#!homepage = https://github.com/taiji951906413/jd-price-loon
#!icon = https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/JingDong.png
#!date = 2026-10-28 10:40

# 脚本全部自托管在本仓库 script/ 目录，源文件取自原作者（见 README 致谢）。
# 引用走 jsdelivr 镜像：raw.githubusercontent.com 在国内不可达。
# 若 gcore 不可用，可整体替换为 fastly.jsdelivr.net 或 testingcf.jsdelivr.net。

[Argument]
Manmanbuy-Cookie = switch, true, false, tag = [京东比价]获取慢慢买Cookie, desc = 首次使用请先打开【慢慢买】APP，提示【获取ck成功🎉】即可正常比价。
JDPrice-TitleEmbed = switch, false, true, tag = [京东比价]标题嵌入版, desc = 点击商品标题即可直接查看嵌入式历史价格
JDPrice-DetailNotify = switch, false, true, tag = [京东比价]详情通知版, desc = 点击商品详情页通过弹窗通知查看历史价格
JDPrice-DetailEmbed-Table = switch, true, false, tag = [京东比价]详情嵌入版（表格图）, desc = 点击商品详情页即可直接查看嵌入式历史价格
JDPrice-DetailEmbed-Line = switch, false, true, tag = [京东比价]详情嵌入版（折线图）, desc = 点击商品详情页即可直接查看嵌入式历史价格

[Rule]
# AND, ((DOMAIN, api.m.jd.com), (PROTOCOL, TCP)), REJECT-NO-DROP
URL-REGEX, "^http:\/\/\w{32}\.jddebug\.com\/diagnose\?", REJECT
# 若慢慢买 App 走 HTTP/3(QUIC)，Loon 无法解密，可解开下面这条强制回落 TCP
# AND, ((DOMAIN, apapia-sqk-weblogic.manmanbuy.com), (PROTOCOL, UDP)), REJECT-DROP

[Rewrite]
request if ${url} ~= /^https?:\/\/m\.360buyimg\.com\/mobilecms\/s1125x2436_jfs/i then reject(200)
request if ${url} ~= /^https?:\/\/api\.m\.jd\.com\/\?loginType=11/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=getWidgetV1052/i then reject(404)
response if ${url} ~= /^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=lite_advertising/i then response.body.replace(/jdLiteAdvertisingVO/, "sooyaaabo")

response if ${url} ~= /^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=basicConfig/i then response.json.replace(["data.JDMessage.socketmonitor.isSocketEstablishedAhead", "data.JDMessage.socketmonitor.isSocketReport", "data.JDHttpToolKit.httpdns.httpdns"], [0, 0, 0])
response if ${url} ~= /^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=cart/i then response.json.delete(["cartLocationMap.loc_emptyCartFloor2", "emptyCartRecommendFloor"])
request if ${url} ~= /^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=(?:cartCouponRecommendGoods|intelligentRecommendSku|obtainGrowingInfo|recommendShop|searchBoxWord|stationPullService|uniformRecommend)/i then reject_dict(200)

[Script]
# 京东去广告
response if ${url} ~= /^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=(?:deliverLayer|getTabHomeInfo|myOrderInfo|orderTrackBusiness|personinfoBusiness|start|welcomeHome)/i then script("https://gcore.jsdelivr.net/gh/taiji951906413/jd-price-loon@main/script/jingdong_ad.js") with tag="[京东]移除广告", requires_body=true

# 京东极速版去广告
response if ${url} ~= /^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=lite_advertising/i then script("https://gcore.jsdelivr.net/gh/taiji951906413/jd-price-loon@main/script/replace-body.js", "jdLiteAdvertisingVO -> sooyaaabo") with tag="[京东]移除京东极速版广告", requires_body=true

# 京东比价 · 获取慢慢买Cookie
request if ${url} ~= /^https?:\/\/apapia-sqk-weblogic\.manmanbuy\.com\/baoliao\/center\/menu$/i then script("https://gcore.jsdelivr.net/gh/taiji951906413/jd-price-loon@main/script/jd_price_mw418.js") with enable=${Manmanbuy-Cookie}, tag="[京东比价]获取慢慢买Cookie", timeout=60, requires_body=true

# 标题嵌入版
response if ${url} ~= /^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=(wareBusiness|serverConfig|basicConfig)/i then script("https://gcore.jsdelivr.net/gh/taiji951906413/jd-price-loon@main/script/jd_price_wf021325.js") with enable=${JDPrice-TitleEmbed}, tag="[京东比价]标题嵌入版", requires_body=true

# 详情通知版
request if ${url} ~= /^https?:\/\/in\.m\.jd\.com\/product\/graphext\/\d+\.html/i then script("https://gcore.jsdelivr.net/gh/taiji951906413/jd-price-loon@main/script/jd_price_mw418.js") with enable=${JDPrice-DetailNotify}, tag="[京东比价]详情通知版", timeout=60

# 详情嵌入版 · 表格图
response if ${url} ~= /^https?:\/\/in\.m\.jd\.com\/product\/graphext\/\d+\.html/i then script("https://gcore.jsdelivr.net/gh/taiji951906413/jd-price-loon@main/script/jd_price_wf021325.js") with enable=${JDPrice-DetailEmbed-Table}, timeout=60, requires_body=true

# 详情嵌入版 · 折线图
response if ${url} ~= /^https?:\/\/in\.m\.jd\.com\/product\/graphext\/\d+\.html/i then script("https://gcore.jsdelivr.net/gh/taiji951906413/jd-price-loon@main/script/JingDong.price.js") with enable=${JDPrice-DetailEmbed-Line}, timeout=60, requires_body=true

[MitM]
hostname = api.m.jd.com, in.m.jd.com, apapia-sqk-weblogic.manmanbuy.com, m.360buyimg.com
